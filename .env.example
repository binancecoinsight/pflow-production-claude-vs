# ==============================================================================
# PHARMACYFLOW SAAS & ADMIN APP - SANITIZED CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your project root:
#      cp .env.example .env
# 2. Populate your Supabase project credentials from your Supabase Dashboard:
#      Project Settings -> API -> Project URL & Anon/Public API Key
# 3. For local database development with Supabase CLI:
#      supabase start
#      (Then use local URL http://127.0.0.1:54321 and provided anon key)
# ==============================================================================

# Supabase Project URL (Client & Server)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anon / Public API Key (Client-side RLS governed)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# Application Public Host URL (Optional, for self-referential links & callbacks)
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# Server-Side Gemini API Key (Optional, for LLM-assisted features)
GEMINI_API_KEY=""

