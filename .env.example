# Browser-visible Supabase configuration. Use values for the target environment.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application runtime configuration.
APP_URL=http://localhost:5173
PORT=5000

# Server-side integration configuration. Supply through the deployment secret manager.
GEMINI_API_KEY=your_gemini_api_key

# Edge Function deployment values are server-side only. Never expose either with a VITE_ prefix.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_server_side_service_role_key
